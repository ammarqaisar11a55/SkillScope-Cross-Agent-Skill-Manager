{
  "name": "skillscope-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SkillScope \u2014 cross-agent skill manager for Claude Code, OpenAI Codex and Cursor",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @skillscope/shared -w @skillscope/core && npm run build -w @skillscope/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "SKILLSCOPE_LIVE_REGISTRY=1 vitest run --project core packages/core/tests/integration",
    "test:e2e": "npm run test:e2e -w @skillscope/desktop",
    "dev": "npm run dev -w @skillscope/desktop",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "package": "npm run build && npm run package -w @skillscope/desktop",
    "verify:release": "node scripts/verify-release.mjs apps/desktop/release --smoke",
    "icon": "python3 -I scripts/generate-icon.py"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.0"
  }
}
